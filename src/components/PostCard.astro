---
import type { CollectionEntry } from "astro:content";
import { slugifySeries } from "../lib/series";
import { formatPostDate } from "../lib/posts";

interface Props {
    post: CollectionEntry<"posts">;
    variant?: "default" | "compact";
    headingLevel?: "h2" | "h3";
    showSeries?: boolean;
}

const {
    post,
    variant = "default",
    headingLevel = "h2",
    showSeries = true,
} = Astro.props;
const { series } = post.data;
const seriesSlug = series ? slugifySeries(series.name) : null;
const Heading = headingLevel;
---

<article class:list={["post-card", { compact: variant === "compact" }] }>
    <div class="meta">
        <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
        {
            showSeries && series && seriesSlug && (
                <>
                    <span class="separator" aria-hidden="true">·</span>
                    <a href={`/series/${seriesSlug}`} class="series-link">
                        Part {series.order} · {series.name}
                    </a>
                </>
            )
        }
    </div>
    <Heading>
        <a href={`/posts/${post.id}`} class="post-title-link">{post.data.title}</a>
    </Heading>
    {variant === "default" && <p>{post.data.description}</p>}
    {
        variant === "default" && post.data.tags.length > 0 && (
            <ul class="tags" aria-label="Topics">
                {post.data.tags.map((tag) => (
                    <li><a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a></li>
                ))}
            </ul>
        )
    }
</article>

<style>
    .post-card {
        padding: 1.5rem 0;
        border-top: 1px solid var(--color-border);
    }

    .meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem;
        min-width: 0;
        margin-bottom: var(--spacing-sm);
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        line-height: 1.5;
    }

    time {
        font-variant-numeric: tabular-nums;
    }

    .series-link {
        min-width: 0;
        color: var(--color-primary);
        text-decoration: none;
    }

    .series-link:hover {
        text-decoration: underline;
    }

    h2,
    h3 {
        max-width: 34ch;
        margin-bottom: 0.5rem;
        font-family: var(--font-serif);
        font-size: clamp(1.3rem, 4vw, 1.55rem);
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: -0.015em;
    }

    .post-title-link {
        color: var(--color-text);
        text-decoration: none;
    }

    .post-title-link:hover {
        color: var(--color-primary);
        text-decoration: none;
    }

    p {
        max-width: 64ch;
        color: var(--color-text-muted);
        font-size: 1rem;
        line-height: 1.65;
        margin-bottom: 1rem;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        list-style: none;
    }

    .tags a {
        display: block;
        font-size: 0.75rem;
        color: var(--color-text-muted);
        border: 1px solid var(--color-border);
        padding: 0.15rem 0.45rem;
        border-radius: 999px;
        text-decoration: none;
    }

    .tags a:hover {
        border-color: var(--color-border-strong);
        color: var(--color-text);
        background: var(--color-surface);
        text-decoration: none;
    }

    .compact {
        display: grid;
        grid-template-columns: minmax(8.5rem, 0.35fr) minmax(0, 1fr);
        gap: var(--spacing-md);
        align-items: baseline;
        padding: 1rem 0;
    }

    .compact .meta,
    .compact h2,
    .compact h3 {
        margin: 0;
    }

    .compact h2,
    .compact h3 {
        max-width: none;
        font-family: var(--font-sans);
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.45;
        letter-spacing: -0.005em;
    }

    @media (max-width: 560px) {
        .compact {
            grid-template-columns: 1fr;
            gap: 0.3rem;
        }

        .separator,
        .compact .series-link {
            display: none;
        }
    }
</style>
