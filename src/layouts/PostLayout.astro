---
import BaseLayout from "./BaseLayout.astro";
import SeriesNav from "../components/SeriesNav.astro";
import type { CollectionEntry } from "astro:content";
import { formatPostDate, getReadingMinutes } from "../lib/posts";
import "../styles/prose.css";

interface Props {
    post: CollectionEntry<"posts">;
    seriesPosts?: CollectionEntry<"posts">[];
}

const { post, seriesPosts = [] } = Astro.props;
const hasSeries = !!post.data.series && seriesPosts.length > 0;
const readingMinutes = getReadingMinutes(post.body);
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    image={post.data.image}
    imageAlt={post.data.imageAlt}
    type="article"
    publishedTime={post.data.date.toISOString()}
>
    <article class="post-content">
        <header class="post-header">
            {hasSeries && <SeriesNav post={post} seriesPosts={seriesPosts} variant="banner" />}
            <h1>{post.data.title}</h1>
            <p class="description">{post.data.description}</p>
            <div class="meta">
                <time datetime={post.data.date.toISOString()}>
                    {formatPostDate(post.data.date, "long")}
                </time>
                <span aria-hidden="true">·</span>
                <span>{readingMinutes} min read</span>
            </div>
            {
                post.data.tags.length > 0 && (
                    <ul class="tags" aria-label="Topics">
                    {
                        post.data.tags.map((tag) => (
                            <li>
                                <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">
                                    #{tag}
                                </a>
                            </li>
                        ))
                    }
                    </ul>
                )
            }
            {
                post.data.image && (
                    <img
                        src={post.data.image}
                        alt={post.data.imageAlt ?? ""}
                        width={post.data.imageWidth}
                        height={post.data.imageHeight}
                        class="hero-image"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                    />
                )
            }
        </header>

        <div class="prose">
            <slot />
        </div>

        {hasSeries && <SeriesNav post={post} seriesPosts={seriesPosts} variant="nav" />}
    </article>
</BaseLayout>

<style>
    .post-header {
        max-width: var(--prose-width);
        margin: 0 auto clamp(3rem, 8vw, 5rem);
    }

    .meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 0.75rem;
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-variant-numeric: tabular-nums;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        list-style: none;
    }

    .tag {
        display: block;
        padding: 0.15rem 0.45rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        color: var(--color-text-muted);
        font-size: 0.75rem;
        text-decoration: none;
    }

    .tag:hover {
        border-color: var(--color-border-strong);
        background: var(--color-surface);
        color: var(--color-text);
        text-decoration: none;
    }

    h1 {
        max-width: 19ch;
        margin-bottom: var(--spacing-md);
        color: var(--color-text);
        font-family: var(--font-serif);
        font-size: clamp(2.35rem, 7vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.03;
    }

    .description {
        max-width: 58ch;
        margin-bottom: var(--spacing-md);
        color: var(--color-text-muted);
        font-family: var(--font-serif);
        font-size: clamp(1.05rem, 3vw, 1.2rem);
        line-height: 1.6;
    }

    .hero-image {
        width: 100%;
        margin-top: var(--spacing-lg);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        background: var(--color-surface);
    }

    @media (max-width: 520px) {
        .post-header {
            margin-bottom: 3rem;
        }

        h1 {
            font-size: clamp(2.15rem, 12vw, 3rem);
        }
    }
</style>
