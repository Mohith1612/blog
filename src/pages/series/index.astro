---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSeriesGroups } from "../../lib/series";

const allPosts = await getCollection("posts");
const seriesGroups = getSeriesGroups(allPosts);
---

<BaseLayout title="Series — Dev Notes" description="All blog series">
    <section class="series-index">
        <header class="page-header">
            <p class="eyebrow">Collections</p>
            <h1>Series</h1>
            <p class="description">Long-form explorations of one system, built and examined piece by piece.</p>
        </header>

        {
            seriesGroups.size === 0 && (
                <p class="empty">No series yet.</p>
            )
        }

        <ul class="series-list">
            {
                [...seriesGroups.entries()].map(([slug, { name, posts }]) => (
                    <li>
                        <a href={`/series/${slug}`} class="series-card">
                            <span>
                                <span class="count">{posts.length} {posts.length === 1 ? "part" : "parts"}</span>
                                <h2>{name}</h2>
                            </span>
                            <span class="arrow" aria-hidden="true">→</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>

<style>
    .series-index {
        max-width: 700px;
    }

    .page-header {
        margin-bottom: clamp(2.5rem, 7vw, var(--spacing-xl));
    }

    .page-header h1 {
        margin-bottom: var(--spacing-sm);
        font-family: var(--font-serif);
        font-size: clamp(2.5rem, 8vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1;
    }

    .eyebrow {
        margin-bottom: var(--spacing-sm);
        color: var(--color-primary);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .page-header .description {
        max-width: 55ch;
        color: var(--color-text-muted);
        font-family: var(--font-serif);
        font-size: 1.1rem;
        line-height: 1.65;
    }

    .series-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        border-bottom: 1px solid var(--color-border);
    }

    .series-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--spacing-md);
        padding: 1.25rem 0;
        border-top: 1px solid var(--color-border);
        text-decoration: none;
        color: inherit;
    }

    .series-card:hover h2 {
        color: var(--color-primary);
    }

    .series-card h2 {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--color-text);
        margin: 0;
        line-height: 1.35;
    }

    .count {
        display: block;
        margin-bottom: var(--spacing-xs);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--color-text-muted);
        white-space: nowrap;
    }

    .arrow {
        color: var(--color-primary);
    }

    .empty {
        color: var(--color-text-muted);
    }
</style>
